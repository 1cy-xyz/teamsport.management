TOKEN=YOUR_DISCORD_BOT_TOKEN

# Your Discord Server (Guild) ID
GUILD_ID=123456789012345678

# Role that can use /dutyadmin
ADMIN_ROLE_ID=123456789012345678

# Role that can create session panels
SESSION_HOST_ROLE_ID=123456789012345678

# Timezone
TIMEZONE=Europe/London

# Embed Colour (Hex without #)
EMBED_COLOR=0099ff
