import os
from dotenv import load_dotenv

load_dotenv()


TOKEN = os.getenv("TOKEN")

DATABASE = os.getenv(
    "DATABASE",
    "staffbot.db"
)

ADMIN_ROLE_ID = int(
    os.getenv("ADMIN_ROLE_ID")
)

SESSION_HOST_ROLE_ID = int(
    os.getenv("SESSION_HOST_ROLE_ID")
)

LOG_CHANNEL_ID = int(
    os.getenv("LOG_CHANNEL_ID")
)

TIMEZONE = os.getenv(
    "TIMEZONE",
    "Europe/London"
)
